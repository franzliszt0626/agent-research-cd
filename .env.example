LLM_MODEL=qwen2.5:14b
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Cloud providers usually require their OpenAI-compatible /v1 base path. Do not add punctuation after the URL.
LLM_TIMEOUT_SECONDS=120
LLM_RETRIES=1
FAILED_NODE_RETRIES=2
FAILED_NODE_RETRY_DELAY_SECONDS=1
CONFIDENCE_THRESHOLD=0.75
# Local CLI/Web automatically starts MCP subprocesses; Docker overrides this to http.
MCP_TRANSPORT=stdio
MCP_URL=http://127.0.0.1:8001/mcp
MCP_TIMEOUT_SECONDS=90
MCP_RETRIES=2
MCP_RETRY_DELAY_SECONDS=0.5
UNPAYWALL_EMAIL=
CROSSREF_MAILTO=
OPENALEX_MAILTO=
